{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-footprint-tracker-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dft.jarvisworlds.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "APP_ENV": "preview",
    "APP_DOMAIN": "dft.jarvisworlds.com",
    "AUTH_MODE": "disabled",
    "TRUSTED_CLIENT_IP_HEADER": "cf-connecting-ip",
  },
}
