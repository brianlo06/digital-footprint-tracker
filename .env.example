# PHASE 2 SYNTHETIC-ONLY FOUNDATION. No live provider or scanning functionality is enabled.
# Copy to .env.local for local development. Never commit populated values.

APP_DOMAIN=YOUR_DOMAIN_HERE
APP_ENV=local
AUTH_MODE=local

# Current local database and authentication configuration
DATABASE_URL=postgres://footprint:local_development_only@127.0.0.1:54329/footprint
# Restricted, non-owner application role. Provision it with scripts/provision-local-runtime-role.sql.
RUNTIME_DATABASE_URL=postgres://digital_footprint_runtime:local_runtime_only@127.0.0.1:54329/footprint
# Optional in the web runtime; required only by the unscheduled retention command/service.
MAINTENANCE_DATABASE_URL=postgres://digital_footprint_maintenance:local_maintenance_only@127.0.0.1:54329/footprint
# Optional in the web runtime; required only for controlled key-rewrap operations.
ROTATION_DATABASE_URL=postgres://digital_footprint_rotation:local_rotation_only@127.0.0.1:54329/footprint
# Optional in the web runtime; required only for controlled lookup-token rotation operations.
LOOKUP_ROTATION_DATABASE_URL=postgres://digital_footprint_lookup_rotation:local_lookup_rotation_only@127.0.0.1:54329/footprint
# Optional in the web runtime; required only by the verification delivery outbox worker. See ADR 0017.
# DELIVERY_DATABASE_URL=postgres://digital_footprint_delivery:local_delivery_only@127.0.0.1:54329/footprint

# Required outside local development before protected mutations are accepted. Configure only a
# single-value IP header that the trusted ingress strips and rewrites; never trust arbitrary
# X-Forwarded-For input directly. Example names depend on the selected hosting platform.
TRUSTED_CLIENT_IP_HEADER=

# Local mode is rejected when NODE_ENV=production. Use a non-personal opaque subject.
LOCAL_AUTH_SUBJECT=local_developer

# Future/production managed authentication through Clerk. Not required in local mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard endpoint signing secret for POST /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Current application-level envelope encryption configuration.
# Prefer a KMS reference in production; never commit key material.
ENCRYPTION_KEY_ID=local-v1
# Base64-encoded 32-byte keys. Generate unique local values; examples are intentionally blank.
ENCRYPTION_KEY=
LOOKUP_KEY=
# Versions HMAC lookup tokens independently of the envelope key; see ADR 0016. Any short opaque
# string, not generated key material.
LOOKUP_KEY_ID=local-lookup-v1
# Both required together, and only while actively exercising a lookup-key rotation drill.
PREVIOUS_LOOKUP_KEY_ID=
PREVIOUS_LOOKUP_KEY=
# Both required together, and only while exercising the verification delivery outbox. See ADR 0017.
DELIVERY_ENCRYPTION_KEY_ID=
DELIVERY_ENCRYPTION_KEY=

# Future multi-instance Server Action key. Leave unset locally. Production instances must share a
# securely generated key through the deployment secret manager.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Local-only verification fake. Never enable or use this fixed-code flow in production.
LOCAL_VERIFICATION_CODE=000000

# Provider selection. The only executable Phase 2 mode is local synthetic; live credentials are
# rejected by the environment schema. To exercise fixtures locally, set BREACH_PROVIDER=synthetic,
# FEATURE_BREACH_SCAN=true, and BREACH_PROVIDER_KILL_SWITCH=false together. Keep the default-off
# values below everywhere else.
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
BREACH_PROVIDER=disabled
BREACH_PROVIDER_KILL_SWITCH=true
BREACH_API_KEY=
BROKER_PROVIDER=disabled
BROKER_API_KEY=
DOMAIN_PROVIDER=disabled
DOMAIN_API_KEY=

# Future notification configuration; dashboard-only is the MVP default.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=

# Feature flags; disabled unless explicitly reviewed and enabled.
FEATURE_BREACH_SCAN=false
FEATURE_BROKER_SCAN=false
FEATURE_SOCIAL_DISCOVERY=false
FEATURE_DOMAIN_SCAN=false
FEATURE_SCHEDULED_SCANS=false
FEATURE_EMAIL_NOTIFICATIONS=false

# Future privacy-safe observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
