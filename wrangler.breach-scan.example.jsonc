{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-footprint-tracker-breach-scan-preview",
  "main": "workers/breach-scan.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "alias": {
    "server-only": "./workers/server-only-noop.ts",
  },
  "hyperdrive": [
    {
      "binding": "SCAN_DATABASE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": { "enabled": false },
  },
  "vars": {
    "SCAN_KILL_SWITCH": "true",
    "SCAN_SYNTHETIC_ENABLED": "false",
    "SCAN_CLAIM_BATCH_SIZE": "10",
    "SCAN_CLAIM_LEASE_SECONDS": "120",
  },
}
