{
  "name": "digital-footprint-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first personal digital footprint evidence platform",
  "engines": {
    "node": "^20.19 || ^22.13 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "sh scripts/build-cloudflare.sh",
    "cf:typegen": "wrangler types --env-file /dev/null --env-interface CloudflareEnv --include-runtime=false --strict-vars=false cloudflare-env.d.ts",
    "cf:typecheck": "wrangler types --env-file /dev/null --env-interface CloudflareEnv --include-runtime=false --strict-vars=false --check cloudflare-env.d.ts",
    "cf:verify:boundaries": "node scripts/verify-cloudflare-deployment-boundaries.mjs",
    "cf:retention:build": "npm run cf:verify:boundaries && wrangler deploy --dry-run --config wrangler.retention.example.jsonc --outdir .wrangler/retention-build",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "upload": "npm run cf:build && OPEN_NEXT_DEPLOY=true wrangler versions upload",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "REQUIRE_DATABASE_TESTS=1 vitest run tests/integration",
    "test:watch": "vitest",
    "audit:production": "npm audit --omit=dev",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision:hosted": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/provision-hosted-database-roles.sql",
    "db:verify:boundaries": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/verify-database-boundaries.sql",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.3",
    "@opennextjs/cloudflare": "^1.20.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.1"
  }
}
